[Unit]
Description=Audio Lab Public Site
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/audio-lab-public-site
Environment=AUDIO_LAB_ROOT=/opt/audio-lab-public-site
Environment=AUDIO_LAB_LIVE_SILENT=1
ExecStart=/usr/bin/python3 /opt/audio-lab-public-site/scripts/run_audio_lab_live.py --host 127.0.0.1 --port 8876 --output-root /opt/audio-lab-public-site/outputs/audio-lab-live --no-autostart
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
